ARG registry
FROM ${registry}/hybitz-almalinux:9.7-20260509-61

ADD Gemfile Gemfile.lock ./
RUN sudo chown -R ${USER}:${USER} ./ && \
    bundle config without 'itamae development test' && \
    bundle install -j2

ADD Rakefile ./
ADD app/assets/config/manifest.js ./app/assets/config/manifest.js
ADD config ./config
ADD lib/omniauth ./lib/omniauth
RUN sudo chown -R ${USER}:${USER} ./ && \
    bundle exec rake dad:setup:base RAILS_ENV=production SECRET_KEY_BASE=dummy
