<% created_time = note.created_at.strftime('%Y-%m-%d %H:%M') %>
<% updated_time = note.updated_at.strftime('%Y-%m-%d %H:%M') %>
<% edited = note.updated_at > note.created_at %>
<div class="note-item" data-note-id="<%= note.id %>">
  <div class="note-item-display" tabindex="0">
    <div class="note-body"><%= note.body %></div>
    <div class="note-timestamp">
      <span class="note-created-at"><%= created_time %></span>
      <% if edited %>
        <span class="note-edited-badge"
              title="<%= t('notes.gadget.edited_tooltip', time: updated_time) %>"
              aria-label="<%= t('notes.gadget.edited_tooltip', time: updated_time) %>"
              data-time="<%= updated_time %>"><%= t('notes.gadget.edited_badge') %></span>
      <% end %>
    </div>
  </div>
  <%= form_with model: note, format: :html, local: false, html: { class: 'note-item-edit-form', hidden: true } do |f| %>
    <%= f.text_area :body, rows: 3 %>
    <%= note_gadget_action_button(
          f,
          label: t('notes.gadget.update'),
          css_class: 'note-item-update-submit',
          aria_label: t('notes.gadget.update_aria_label', update: t('notes.gadget.update'), shortcut: t('notes.gadget.submit_shortcut'))
        ) %>
  <% end %>
  <button type="button" class="note-item-cancel-button" hidden><%= t('notes.gadget.cancel') %></button>
  <%= button_to t('notes.gadget.delete'),
                note_path(note),
                method: :delete,
                form: { class: 'note-item-delete-form', hidden: true } %>
</div>
