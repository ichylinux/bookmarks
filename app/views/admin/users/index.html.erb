<section class="admin-users" aria-labelledby="admin-users-heading">
  <h1 id="admin-users-heading"><%= t('.title') %></h1>
  <div class="admin-users__table-scroll">
    <table class="admin-users__table">
      <thead>
        <tr>
          <th scope="col"><%= t('.col_id') %></th>
          <th scope="col"><%= t('.col_email') %></th>
          <th scope="col"><%= t('.col_x_user_name') %></th>
          <th scope="col"><%= t('.col_admin_flag') %></th>
          <th scope="col"><%= t('.col_last_sign_in_at') %></th>
          <th scope="col"><%= t('.col_created_at') %></th>
          <th scope="col"><%= t('.col_updated_at') %></th>
          <th scope="col"><%= t('.col_actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.id %></td>
            <td><%= user.email %></td>
            <td><%= user.x_accounts.reject(&:deleted?).sort_by(&:id).first&.username %></td>
            <td><%= user.admin? ? '✓' : '—' %></td>
            <td><%= user.last_sign_in_at ? l(user.last_sign_in_at, format: :admin_datetime) : '—' %></td>
            <td><%= l(user.created_at, format: :admin_datetime) %></td>
            <td><%= l(user.updated_at, format: :admin_datetime) %></td>
            <td>
              <% if user.purgeable? %>
                <%= link_to t('.purge_button'), confirm_purge_admin_user_path(user) %>
              <% else %>
                —
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
