<li class="gadget-entry">
  <% if current_user.preference&.use_feed_article_histories? %>
    <%= render 'common/entry_like_button',
          url: url,
          title: title,
          source: source,
          gadget_id: gadget_id,
          liked_urls: liked_urls %>
  <% end %>
  <%= link_to title, url, **link_opts, class: visited_link_class(visited_urls, url) %>
</li>