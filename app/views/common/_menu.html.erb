<div class="header">
  <script>
    function toggle_menu(trigger, menu) {
      menu.toggleClass('hidden');
      if (menu.is(':visible')) {
        menu.css('min-width', trigger.outerWidth() - 10);
        menu.position({my: 'right top', at: 'right bottom', of: trigger});
      }
    }

    $(document).ready(function() {
      const header = $('.header').first();
      const email = header.find('.email').first();
      const menu = header.find('.menu').first();

      email.click(function() {
        toggle_menu(email, menu);
      });

      menu.delegate('a', 'click', function() {
        if ($(this).attr('target') == '_blank') {
          toggle_menu(email, menu);
        }
      });
      
      $('html').click(function(e) {
        if ($(e.target).closest('.email').length == 0) {
          menu.addClass('hidden');
        }
      });
    });
  </script>
  <div>
    <ul class="navigation">
      <li>
        <%= render 'common/navigation_link',
                   url: root_path,
                   label: t('nav.home'),
                   icon: :home,
                   highlight: simple_nav_welcome_home_current?,
                   aria_current_page: simple_nav_welcome_home_current? %>
      </li>
      <% if current_user.preference&.use_note? %>
        <% notes_open = simple_nav_welcome_notes_open? %>
        <% note_label = notes_open ? t('nav.note_return') : t('nav.note') %>
        <% note_url = notes_open ? root_path : root_path(tab: 'notes') %>
        <li>
          <%= render 'common/navigation_link',
                     url: note_url,
                     label: note_label,
                     icon: :note,
                     highlight: notes_open,
                     aria_current_page: false %>
        </li>
      <% end %>
      <% if current_user.preference&.use_feed_article_histories? %>
        <li>
          <%= render 'common/navigation_link',
                     url: feed_article_histories_path,
                     label: t('nav.feed_article_histories'),
                     icon: :history,
                     highlight: simple_nav_feed_histories_current?,
                     aria_current_page: simple_nav_feed_histories_current? %>
        </li>
      <% end %>
      <li class="email">
        <a href="#"><%= current_user.display_name %><span style="font-size: 0.8em;"> ▼</span></a>
        <div class="menu hidden">
          <%= render 'common/nav_sections', variant: :menu %>
        </div>
      </li>
    </ul>
  </div>
</div>
