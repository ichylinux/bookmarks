<% link_opts = current_user.preference.open_links_in_new_tab? ? { target: '_blank', rel: 'noopener noreferrer' } : {} %>
<div>
  <%= render 'common/gadget_title_with_icon',
        variant: :feed,
        image_url: @feed.gadget_title_icon_image_url do %>
    <%= link_to @feed.title, @feed.url, link_opts %>
  <% end %>
  <ol>
    <% @feed.entries.each do |e| %>
      <li><%= link_to e.title, e.url, **link_opts, class: visited_link_class(@visited_urls, e.url) %></li>
    <% end %>
  </ol>
</div>
