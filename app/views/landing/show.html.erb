<main class="landing-page">
  <section class="landing-hero">
    <p class="landing-eyebrow"><%= t('landing.hero.eyebrow') %></p>
    <h1><%= t('landing.hero.title') %></h1>
    <p class="landing-description"><%= t('landing.hero.description') %></p>
    <div class="landing-cta-group">
      <%= link_to t('landing.cta.sign_up'), new_user_registration_path, class: 'landing-cta landing-cta--primary' %>
      <%= link_to t('landing.cta.sign_in'), new_user_session_path, class: 'landing-cta landing-cta--secondary' %>
    </div>
  </section>

  <section class="landing-value-grid">
    <article class="landing-value-card">
      <h2><%= t('landing.values.capture.title') %></h2>
      <p><%= t('landing.values.capture.body') %></p>
    </article>
    <article class="landing-value-card">
      <h2><%= t('landing.values.organize.title') %></h2>
      <p><%= t('landing.values.organize.body') %></p>
    </article>
    <article class="landing-value-card">
      <h2><%= t('landing.values.focus.title') %></h2>
      <p><%= t('landing.values.focus.body') %></p>
    </article>
  </section>

  <section class="landing-changelog">
    <h2 class="changelog-heading"><%= t('landing.changelog.heading') %></h2>
    <% changelog_entries.each do |entry| %>
      <article class="changelog-card">
        <div class="changelog-card-meta">
          <time class="changelog-date" datetime="<%= entry[:date] %>"><%= entry[:date] %></time>
          <span class="changelog-tag changelog-tag--<%= entry[:tag] %>">
            <%= t("landing.changelog.tags.#{entry[:tag]}") %>
          </span>
        </div>
        <h3 class="changelog-headline"><%= entry[:headline] %></h3>
        <p class="changelog-description"><%= entry[:description] %></p>
      </article>
    <% end %>
  </section>
</main>
