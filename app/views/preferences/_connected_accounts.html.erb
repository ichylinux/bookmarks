<section class="connected-accounts">
  <h2 class="connected-accounts__heading"><%= t('preferences.index.connected_accounts_section_title') %></h2>
  <table class="connected-accounts__table">
    <% linked_providers = oauth_identities.map(&:provider).to_set %>

    <tr class="connected-accounts__row">
      <th class="connected-accounts__provider">
        <span class="connected-accounts__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" role="img" class="connected-accounts__svg">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
        </span>
        <%= t('preferences.index.connected_accounts.google') %>
      </th>
      <td class="connected-accounts__status">
        <% if linked_providers.include?('google_oauth2') %>
          <span class="connected-accounts__badge connected-accounts__badge--connected"><%= t('preferences.index.connected_accounts.connected') %></span>
          <%= button_to t('preferences.index.connected_accounts.disconnect'),
                oauth_identity_path('google_oauth2'),
                method: :delete,
                class: 'connected-accounts__disconnect-btn' %>
        <% else %>
          <span class="connected-accounts__badge connected-accounts__badge--unlinked"><%= t('preferences.index.connected_accounts.not_connected') %></span>
        <% end %>
      </td>
    </tr>

    <tr class="connected-accounts__row">
      <th class="connected-accounts__provider">
        <span class="connected-accounts__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="connected-accounts__svg">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </span>
        <%= t('preferences.index.connected_accounts.twitter') %>
      </th>
      <td class="connected-accounts__status">
        <% if linked_providers.include?('twitter2') %>
          <span class="connected-accounts__badge connected-accounts__badge--connected"><%= t('preferences.index.connected_accounts.connected') %></span>
          <%= button_to t('preferences.index.connected_accounts.disconnect'),
                oauth_identity_path('twitter2'),
                method: :delete,
                class: 'connected-accounts__disconnect-btn' %>
        <% else %>
          <span class="connected-accounts__badge connected-accounts__badge--unlinked"><%= t('preferences.index.connected_accounts.not_connected') %></span>
        <% end %>
      </td>
    </tr>

    <tr class="connected-accounts__row">
      <th class="connected-accounts__provider">
        <span class="connected-accounts__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#1877F2" class="connected-accounts__svg">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </span>
        <%= t('preferences.index.connected_accounts.facebook') %>
      </th>
      <td class="connected-accounts__status">
        <% if linked_providers.include?('facebook') %>
          <span class="connected-accounts__badge connected-accounts__badge--connected"><%= t('preferences.index.connected_accounts.connected') %></span>
          <%= button_to t('preferences.index.connected_accounts.disconnect'),
                oauth_identity_path('facebook'),
                method: :delete,
                class: 'connected-accounts__disconnect-btn' %>
        <% else %>
          <span class="connected-accounts__badge connected-accounts__badge--unlinked"><%= t('preferences.index.connected_accounts.not_connected') %></span>
        <% end %>
      </td>
    </tr>

    <tr class="connected-accounts__row">
      <th class="connected-accounts__provider">
        <span class="connected-accounts__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="connected-accounts__svg">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
        </span>
        <%= t('preferences.index.connected_accounts.email_password') %>
      </th>
      <td class="connected-accounts__status">
        <% if user.password_auth_enabled? %>
          <span class="connected-accounts__badge connected-accounts__badge--connected"><%= t('preferences.index.connected_accounts.connected') %></span>
          <%= button_to t('preferences.index.connected_accounts.disconnect'),
                oauth_identity_path('form'),
                method: :delete,
                class: 'connected-accounts__disconnect-btn' %>
        <% else %>
          <span class="connected-accounts__badge connected-accounts__badge--unlinked"><%= t('preferences.index.connected_accounts.not_connected') %></span>
        <% end %>
      </td>
    </tr>
  </table>
</section>
