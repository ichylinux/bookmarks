<script>
  (function prehydrateMobilePortalColumn() {
    try {
      if (!window.matchMedia || !window.matchMedia('(max-width: 767px)').matches) return;
      const raw = window.localStorage.getItem('portalMobileActiveColumn');
      const restored = Number.parseInt(raw, 10);
      // 'note' is also a valid sentinel (portal_mobile_tabs.js circular swipe);
      // Number.parseInt('note', 10) is NaN so the guard below already no-ops it.
      if (Number.isNaN(restored) || restored < 0) return;
      document.documentElement.style.setProperty('--portal-initial-active-index', String(restored));
    } catch (e) {
      // Ignore localStorage access errors in private mode or restricted browsers.
    }
  })();

  function collect_portal_layout_params() {
    <% @portal.portal_column_count.times.each do |i| %>
      const column_<%= i %> = [];
      $('#column_<%= i %> > div').each(function() {
        column_<%= i %>.push($(this).attr('id'));
      });
    <% end %>

    return {
      'authenticity_token': '<%= form_authenticity_token %>',
      <% @portal.portal_column_count.times.each do |i| %>
        'portal[column_<%= i %>]': column_<%= i %>,
      <% end %>
    };
  }

  $(document).ready(function() {
    window.portalGadgetSort.init({
      saveUrl: '<%= url_for action: 'save_state' %>',
      collectParams: collect_portal_layout_params
    });
  });
</script>

<% if favorite_theme == 'simple' %>
  <% use_note = current_user.preference&.use_note? %>
  <% notes_active = use_note && (params[:tab].to_s == 'notes') %>
  <div id="simple-home-panel" class="simple-tab-panel <%= 'simple-tab-panel--hidden' if notes_active %>">
    <%= render 'portal_column_section', portal_columns: @portal.portal_columns, show_column_nav_buttons: current_user.preference&.show_column_nav_buttons != false, portal_column_widths: current_user.preference&.effective_portal_column_widths %>
  </div>

  <% if use_note %>
    <div id="notes-tab-panel" class="simple-tab-panel<%= ' simple-tab-panel--hidden' unless notes_active %>" role="tabpanel">
      <div class="note-gadget-loading">
        <span><%= t('notes.gadget.loading') %></span>
      </div>
    </div>
  <% end %>
<% else %>
  <% use_note = current_user.preference&.use_note? %>
  <% notes_active = use_note && (params[:tab].to_s == 'notes') %>
  <div id="welcome-home-panel" class="welcome-tab-panel <%= 'welcome-tab-panel--hidden' if notes_active %>">
    <%= render 'portal_column_section', portal_columns: @portal.portal_columns, show_column_nav_buttons: current_user.preference&.show_column_nav_buttons != false, portal_column_widths: current_user.preference&.effective_portal_column_widths %>
  </div>

  <% if use_note %>
    <div id="notes-tab-panel" class="welcome-tab-panel<%= ' welcome-tab-panel--hidden' unless notes_active %>" role="tabpanel">
      <div class="note-gadget-loading">
        <span><%= t('notes.gadget.loading') %></span>
      </div>
    </div>
  <% end %>
<% end %>
