<% bookmark_link_html_options = current_user.preference.open_links_in_new_tab? ? { target: '_blank', rel: 'noopener noreferrer' } : {} %>
<% available_folders = Bookmark.where(user_id: current_user.id, deleted: false).folders.order(:title) %>

<div id="<%= gadget.gadget_id %>" class="gadget">
  <div>
    <div class="title title--gadget-with-icon" data-gadget-icon="bookmark">
      <span class="gadget-title-drag-handle">
        <span class="gadget-title-icon gadget-title-icon--bookmark" aria-hidden="true">
          <%= render 'icons/service', variant: :bookmark %>
        </span>
        <span class="gadget-title-text"><%= gadget.title %></span>
      </span>
      <a href="#" class="bookmark-gadget-new-link" aria-label="<%= t('welcome.bookmark_gadget.new_link_aria_label') %>" data-dialog="bookmark-new-dialog"><%= t('welcome.bookmark_gadget.new_link') %></a>
    </div>

    <% # フォルダを先頭に、その後ブックマークをタイトル順で表示（フォルダは開閉可能） %>
    <% root_bookmarks = gadget.entries.select(&:file?) %>
    <div class="bookmark-folders">
      <% gadget.entries.each do |item| %>
        <% next unless item.folder? %>
        <div class="folder-header" data-folder-id="<%= item.id %>">
          <span class="folder-toggle" aria-hidden="true"></span>
          <span class="folder-name"><%= item.title %></span>
        </div>
        <ol class="bookmark-list folder-bookmarks" id="folder-<%= item.id %>" style="display: none;">
          <% item.children.where(deleted: false).order(:title).each do |bookmark| %>
            <li><%= link_to bookmark.title, bookmark.url, bookmark_link_html_options %></li>
          <% end %>
        </ol>
      <% end %>
      <% if root_bookmarks.any? %>
        <ol class="bookmark-list root-bookmarks">
          <% root_bookmarks.each do |bookmark| %>
            <li><%= link_to bookmark.title, bookmark.url, bookmark_link_html_options %></li>
          <% end %>
        </ol>
      <% end %>
    </div>
  </div>
</div>

<dialog id="bookmark-new-dialog" class="bookmark-new-dialog">
  <div class="bookmark-new-dialog__inner">
    <div class="bookmark-new-dialog__header">
      <span class="bookmark-new-dialog__title"><%= t('welcome.bookmark_gadget.dialog_title') %></span>
      <button type="button" class="bookmark-new-dialog__close" aria-label="<%= t('welcome.bookmark_gadget.dialog_close_aria_label') %>" data-dialog-close="bookmark-new-dialog">&#x2715;</button>
    </div>
    <%= form_tag bookmarks_path, method: :post, class: 'bookmark-new-dialog__form', remote: true, data: { gadget_url: gadget_bookmarks_path } do %>
      <%= hidden_field_tag :return_to, 'dashboard' %>
      <% if available_folders.any? %>
        <div class="bookmark-new-dialog__field">
          <%= label_tag 'dialog_bookmark_parent_id', t('bookmarks.form.parent_folder') %>
          <%= select_tag 'bookmark[parent_id]',
              options_for_select([[t('bookmarks.form.no_parent'), '']] + available_folders.map { |f| [f.title, f.id] }),
              id: 'dialog_bookmark_parent_id', class: 'bookmark-new-dialog__select' %>
        </div>
      <% end %>
      <div class="bookmark-new-dialog__field">
        <%= label_tag 'bookmark_url', t('bookmarks.form.url_placeholder') %>
        <%= text_field_tag 'bookmark[url]', nil, id: 'bookmark_url', placeholder: t('bookmarks.form.url_placeholder'), class: 'bookmark-new-dialog__input' %>
      </div>
      <div class="bookmark-new-dialog__field">
        <%= label_tag 'bookmark_title', Bookmark.human_attribute_name(:title) %>
        <div class="bookmark-new-dialog__title-row">
          <%= text_field_tag 'bookmark[title]', nil, id: 'bookmark_title', class: 'bookmark-new-dialog__input' %>
          <button type="button"
                  onclick="bookmarks.fetch_title_from_url(this); return false;"
                  data-url="<%= fetch_title_bookmarks_path %>"
                  data-bookmark-url-required-message="<%= t('bookmarks.form.url_required_for_title_fetch') %>"
                  data-bookmark-title-fetch-failed-message="<%= t('bookmarks.form.title_fetch_failed') %>"
                  class="bookmark-new-dialog__fetch-btn"><%= t('bookmarks.form.fetch_from_url') %></button>
        </div>
      </div>
      <div class="bookmark-new-dialog__actions">
        <%= submit_tag t('bookmarks.form.submit_create_bookmark'), class: 'bookmark-new-dialog__submit' %>
      </div>
    <% end %>
  </div>
</dialog>
