<div id="<%= gadget.gadget_id %>" class="gadget todo">
  <script>
    $(document).ready(function() {
      todos.init('#<%= gadget.gadget_id %>');
    });
  </script>

  <div>
    <%= render 'common/gadget_title_with_icon',
               variant: :todo,
               header_link: link_to(
                 t('welcome.todo_gadget.new_link'),
                 new_todo_path,
                 class: 'todo-gadget-new-link',
                 aria: { label: t('welcome.todo_gadget.new_link_aria_label') },
                 onclick: 'todos.new_todo(this); return false;'
               ) do %>
      <%= gadget.title %>
    <% end %>
    <ol data-complete-url="<%= delete_todos_path %>"
        data-undo-url="<%= undo_complete_todos_path %>"
        data-authenticity-token="<%= form_authenticity_token %>"
        data-toast-completed="<%= t('todos.toast.completed', title: '%{title}') %>"
        data-toast-undo="<%= t('todos.toast.undo') %>">
      <% gadget.entries.each do |todo| %>
        <%= render todo %>
      <% end %>
    </ol>
  </div>
</div>
