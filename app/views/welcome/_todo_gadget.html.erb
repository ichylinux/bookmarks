<div id="<%= gadget.gadget_id %>" class="gadget todo">
  <script>
    $(document).ready(function() {
      todos.init('#<%= gadget.gadget_id %>');
    });
  </script>

  <div>
    <%= render 'common/gadget_title_with_icon', variant: :todo do %>
      <%= gadget.title %>
    <% end %>
    <ol>
      <%= render 'todos/actions' %>

      <% gadget.entries.each do |todo| %>
        <%= render todo %>
      <% end %>
    </ol>
  </div>
</div>
