<main class="landing-page">
  <div class="landing-lang-switcher">
    <%= link_to "日本語", root_path(locale: 'ja'), class: "landing-lang-link #{'landing-lang-link--active' if I18n.locale == :ja}" %>
    <%= link_to "English", root_path(locale: 'en'), class: "landing-lang-link #{'landing-lang-link--active' if I18n.locale == :en}" %>
  </div>
  <section class="landing-hero">
    <p class="landing-eyebrow"><%= t('landing.hero.eyebrow') %></p>
    <h1><%= t('landing.hero.title') %></h1>
    <p class="landing-description"><%= t('landing.hero.description') %></p>
    <div class="landing-cta-group">
      <% if user_signed_in? %>
        <%= link_to t('landing.cta.continue_to_app'), root_path, class: 'landing-cta landing-cta--primary' %>
      <% else %>
        <%= link_to t('landing.cta.sign_up'), new_user_registration_path, class: 'landing-cta landing-cta--primary' %>
        <%= link_to t('landing.cta.sign_in'), new_user_session_path, class: 'landing-cta landing-cta--secondary' %>
      <% end %>
    </div>
  </section>

  <section class="landing-value-grid">
    <article class="landing-value-card">
      <div class="landing-value-card-header">
        <span class="landing-value-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2z"/></svg>
        </span>
        <h2><%= t('landing.values.capture.title') %></h2>
      </div>
      <p><%= t('landing.values.capture.body') %></p>
    </article>
    <article class="landing-value-card">
      <div class="landing-value-card-header">
        <span class="landing-value-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/></svg>
        </span>
        <h2><%= t('landing.values.organize.title') %></h2>
      </div>
      <p><%= t('landing.values.organize.body') %></p>
    </article>
    <article class="landing-value-card">
      <div class="landing-value-card-header">
        <span class="landing-value-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
        </span>
        <h2><%= t('landing.values.focus.title') %></h2>
      </div>
      <p><%= t('landing.values.focus.body') %></p>
    </article>
  </section>

  <section class="landing-integrations">
    <h2 class="landing-integrations-heading"><%= t('landing.integrations.heading') %></h2>
    <div class="landing-integration-list">
      <article class="landing-integration-card">
        <h3><%= t('landing.integrations.x.title') %></h3>
        <p><%= t('landing.integrations.x.body') %></p>
      </article>
      <article class="landing-integration-card">
        <h3><%= t('landing.integrations.mastodon.title') %></h3>
        <p><%= t('landing.integrations.mastodon.body') %></p>
      </article>
    </div>
  </section>

  <section class="landing-changelog">
    <h2 class="changelog-heading"><%= t('landing.changelog.heading') %></h2>
    <% changelog_entries.each do |entry| %>
      <article class="changelog-card">
        <div class="changelog-card-meta">
          <time class="changelog-date" datetime="<%= entry[:date] %>"><%= entry[:date] %></time>
          <span class="changelog-tag changelog-tag--<%= entry[:tag] %>">
            <%= t("landing.changelog.tags.#{entry[:tag]}") %>
          </span>
        </div>
        <h3 class="changelog-headline"><%= entry[:headline] %></h3>
        <p class="changelog-description"><%= entry[:description] %></p>
      </article>
    <% end %>
  </section>
</main>
