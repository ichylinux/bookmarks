<script>
  $(document).ready(function() {
    window.portalLazy.register(<%= local_assigns.fetch(:column_index, 0) %>, function() {
      $.get('<%= feed_path(gadget) %>', {format: 'html'}, function(html) {
        $('#feed_<%= gadget.id %>').html(html);
      })
      .fail(function(xhr, status, error) {
        const container = $('#feed_<%= gadget.id %>');
        container.find('ol li span').first().text(container.data('fetchFailedMessage') + '(' + xhr.status + ')');
      });
    });
  });
</script>

<div id="<%= gadget.gadget_id %>" class="gadget" data-fetch-failed-message="<%= t('.fetch_failed') %>">
  <div>
    <%= render 'common/gadget_title_with_icon', variant: :feed, image_url: nil do %>
      <%= gadget.title %>
    <% end %>
    <ol>
      <li>
        <span style="line-height: <%= gadget.display_count * 1.5 %>em;"><%= t('.loading') %></span>
      </li>
    </ol>
  </div>
</div>
