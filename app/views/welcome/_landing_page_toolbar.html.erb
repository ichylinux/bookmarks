<%# locals: path_helper (Symbol), back_home_key (String) %>
<div class="landing-page__toolbar">
  <%= link_to root_path, class: 'landing-back-link' do %>
    <span aria-hidden="true">←</span>
    <%= t(back_home_key).sub(/\A←\s*/, '') %>
  <% end %>
  <%= render 'welcome/landing_lang_switcher', path_helper: path_helper %>
</div>
