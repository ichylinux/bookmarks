<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Bookmarks</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag    'application', media: 'all' %>
    <%= javascript_include_tag 'application' %>

  </head>

  <body class="<%= [favorite_theme, font_size_class, no_icons_class, ('auth-flow' if auth_flow_page?)].compact.join(' ').strip %>">
    <%= render 'layouts/header' %>

    <div class="wrapper">
      <%= render 'common/menu' if user_signed_in? && favorite_theme == 'simple' %>
      <% if flash[:notice].present? %>
        <div class="flash-message flash-notice" role="status">
          <span class="flash-message__body"><%= flash[:notice] %></span>
          <button type="button" class="flash-dismiss" aria-label="<%= t('flash.dismiss') %>" data-dismiss-flash></button>
        </div>
      <% end %>
      <% if flash[:alert].present? %>
        <div class="flash-message flash-alert" role="alert">
          <span class="flash-message__body"><%= flash[:alert] %></span>
          <button type="button" class="flash-dismiss" aria-label="<%= t('flash.dismiss') %>" data-dismiss-flash></button>
        </div>
      <% end %>
      <%= yield %>
    </div>
    <%= render 'common/drawer' if drawer_ui? %>
  </body>
</html>
