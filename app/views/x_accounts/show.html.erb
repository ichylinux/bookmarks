<% link_opts = current_user.preference.open_links_in_new_tab? ? { target: '_blank', rel: 'noopener noreferrer' } : {} %>
<div>
  <%= render 'common/gadget_title_with_icon', variant: :x do %>
    <%= link_to @x_account.title, @x_account.profile_url, link_opts %>
  <% end %>
  <% if @x_error %>
    <ol>
      <li>
        <span><%= t("errors.x_client.#{@x_error}") %></span>
        <% if @x_error == :unauthorized %>
          <div><%= button_to t('welcome.x_account.reauthorize'), user_twitter_omniauth_authorize_path, method: :post %></div>
        <% end %>
      </li>
    </ol>
  <% elsif @x_items.blank? %>
    <ol>
      <li><span><%= t('welcome.x_account.empty') %></span></li>
    </ol>
  <% else %>
    <ol>
      <% @x_items.each do |item| %>
        <li><%= link_to item[:text], item[:url], **link_opts, class: visited_link_class(@visited_urls, item[:url]) %></li>
      <% end %>
    </ol>
  <% end %>
</div>
