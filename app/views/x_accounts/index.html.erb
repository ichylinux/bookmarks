<section class="x-accounts-page" aria-labelledby="x-accounts-heading">
  <header class="x-accounts-page__header">
    <div class="x-accounts-page__title-row">
      <h1 id="x-accounts-heading" class="x-accounts-page__title"><%= t('x_accounts.index.title') %></h1>
      <%= button_to t('x_accounts.index.refresh'),
            refresh_x_accounts_path,
            method: :post,
            form: { class: 'x-accounts-page__refresh-form' },
            class: 'x-accounts-page__refresh-btn' %>
    </div>
    <% if current_user.x_accounts_last_refreshed_at.present? %>
      <p class="x-accounts-page__meta">
        <%= t('x_accounts.index.last_refreshed',
              time: l(current_user.x_accounts_last_refreshed_at, format: :short)) %>
      </p>
    <% end %>
  </header>

  <% if current_user.oauth2_token.blank? %>
    <div class="flash-message flash-notice x-accounts-page__notice" role="status">
      <span class="flash-message__body"><%= t('x_accounts.oauth2_upgrade.prompt') %></span>
      <%= button_to t('x_accounts.oauth2_upgrade.button'),
            user_twitter2_omniauth_authorize_path,
            method: :post,
            class: 'x-accounts-page__upgrade-btn' %>
    </div>
  <% end %>

  <% if @selection_soft_warning %>
    <div class="flash-message flash-notice x-accounts-page__notice" role="status">
      <span class="flash-message__body"><%= t('x_accounts.index.selection_soft_warning') %></span>
    </div>
  <% end %>

  <% if @x_accounts.blank? %>
    <p class="x-accounts-page__empty"><%= t('x_accounts.index.empty') %></p>
  <% else %>
    <div class="x-accounts-list">
      <% @x_accounts.each do |account| %>
        <%= form_with model: account, url: x_account_path(account), method: :patch, local: true, html: { class: 'x-account-card' } do |f| %>
          <div class="x-account-card__head">
            <div class="x-account-card__identity">
              <h2 class="x-account-card__display-name"><%= account.display_name.presence || '@' + account.username %></h2>
              <p class="x-account-card__username">@<%= account.username %></p>
            </div>
          </div>

          <div class="x-account-card__grid">
            <div class="x-account-card__cell x-account-card__cell--toggle">
              <span class="x-account-card__label"><%= XAccount.human_attribute_name(:selected) %></span>
              <label class="x-account-card__check-wrap">
                <%= f.check_box :selected %>
              </label>
            </div>
            <div class="x-account-card__cell">
              <span class="x-account-card__label"><%= XAccount.human_attribute_name(:display_name) %></span>
              <span class="x-account-card__value"><%= account.display_name %></span>
            </div>
            <div class="x-account-card__cell">
              <span class="x-account-card__label"><%= XAccount.human_attribute_name(:username) %></span>
              <span class="x-account-card__value">@<%= account.username %></span>
            </div>
            <div class="x-account-card__cell">
              <span class="x-account-card__label"><%= XAccount.human_attribute_name(:display_count) %></span>
              <%= f.number_field :display_count, min: 1, class: 'x-account-card__number-input' %>
            </div>
            <div class="x-account-card__cell">
              <span class="x-account-card__label"><%= t('x_accounts.index.protected_column') %></span>
              <span class="x-account-card__value">
                <% if account.protected? %>
                  <%= t('x_accounts.index.protected_badge') %>
                <% else %>
                  —
                <% end %>
              </span>
            </div>
            <div class="x-account-card__cell">
              <span class="x-account-card__label"><%= t('x_accounts.index.ack_column') %></span>
              <% if account.protected? %>
                <label class="x-account-card__check-wrap x-account-card__check-wrap--ack">
                  <%= f.check_box :protected_acknowledged %>
                </label>
              <% else %>
                <span class="x-account-card__value x-account-card__value--muted">—</span>
              <% end %>
            </div>
          </div>

          <div class="x-account-card__footer">
            <%= f.submit t('x_accounts.index.row_submit') %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
