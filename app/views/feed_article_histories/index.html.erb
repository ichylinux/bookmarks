<% link_opts = current_user.preference.open_links_in_new_tab? ? { target: '_blank', rel: 'noopener noreferrer' } : {} %>

<% unless @feed_article_histories.present? %>
  <div><%= t('feed_article_histories.index.empty') %></div>
<% else %>
  <ol>
    <% @feed_article_histories.each do |link| %>
      <% source_label = t("feed_article_histories.index.sources.#{link.source}") %>
      <li>
        <span class="history-source-icon" role="img"
              aria-label="<%= source_label %>" title="<%= source_label %>">
          <%= render 'icons/service', variant: link.source.to_sym %>
        </span>
        <%= link_to link.title.presence || link.url, link.url, **link_opts %>
        <span class="history-meta">
          <% if link.gadget_id.present? %>
            <span class="history-gadget-label"><%= @gadget_titles[link.gadget_id] || t('feed_article_histories.index.gadget_removed') %></span>
          <% end %>
          <time class="history-visited-at" datetime="<%= link.visited_at.iso8601 %>">
            <%= l(link.visited_at, format: :admin_datetime) %>
          </time>
        </span>
      </li>
    <% end %>
  </ol>
<% end %>

<%= paginate @feed_article_histories if @feed_article_histories.total_pages > 1 %>
