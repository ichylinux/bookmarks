<%= render layout: 'devise/shared/auth_frame',
           locals: {
             intro: t('landing.auth.sign_in_intro'),
             path_helper: :new_user_session_path,
             page_class: 'auth-page--sign-in'
           } do %>
  <h1 id="auth-sign-in-heading" class="auth-card__title"><%= t('devise.sessions.new.sign_in') %></h1>

  <%= render 'devise/shared/oauth_buttons' %>

  <div class="auth-divider">
    <span><%= t('landing.auth.or_with_email') %></span>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth-form' }) do |f| %>
    <div class="auth-field">
      <%= f.label :email, class: 'auth-label' %>
      <%= f.email_field :email, autofocus: true, autocomplete: 'email', class: 'auth-input' %>
    </div>

    <div class="auth-field">
      <%= f.label :password, class: 'auth-label' %>
      <%= f.password_field :password, autocomplete: 'current-password', class: 'auth-input' %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="auth-field auth-field--checkbox">
        <%= f.check_box :remember_me, class: 'auth-checkbox' %>
        <%= f.label :remember_me, class: 'auth-checkbox-label' %>
      </div>
    <% end %>

    <div class="auth-actions">
      <%= f.submit t('devise.sessions.new.sign_in'), class: 'auth-submit auth-submit--secondary' %>
    </div>
  <% end %>

  <div class="auth-links">
    <%= render 'devise/shared/links' %>
  </div>
<% end %>
